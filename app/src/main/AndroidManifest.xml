<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_fixpro"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_fixpro"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidAppTemplate"
        tools:targetApi="31">
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FixPro.Login">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity 
            android:name=".MainActivity"
            android:theme="@style/Theme.FixPro.Login" />
        <activity
            android:name=".ui.usuario.CadastroUsuarioActivity"
            android:theme="@style/Theme.FixPro.Login" />
        <activity
            android:name=".ui.configuracoes.AccountSettingsActivity"
            android:label="Conta"
            android:theme="@style/Theme.AndroidAppTemplate"/>
        <activity
            android:name=".ui.configuracoes.SettingsActivity"
            android:label="Configurações"
            android:theme="@style/Theme.AndroidAppTemplate"/>
        <activity
            android:name=".ui.detalhes.DetalhesServicoActivity"
            android:exported="false"
            android:theme="@style/Theme.FixPro.Login" />
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.FixPro.Login" />
    </application>
</manifest>