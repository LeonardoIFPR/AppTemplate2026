<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0C0C12">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="54dp"
        android:paddingBottom="14dp"
        android:paddingHorizontal="20dp"
        android:background="#1A1A24">

        <ImageButton
            android:id="@+id/btnBackMap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_ios"
            app:tint="#FFFFFF"
            android:contentDescription="Voltar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/txtMapTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rota até o cliente"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMapSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculando rota..."
                android:textColor="#80FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Distância pill -->
        <TextView
            android:id="@+id/txtMapDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2200C9A7"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="--"
            android:textColor="#00C9A7"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/osmMapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom info bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1A1A24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_marker_fixpro_worker" />

            <TextView
                android:id="@+id/txtMapClientAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Carregando endereço..."
                android:textColor="#E0FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Rota via OpenStreetMap · OSRM"
            android:textColor="#30FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
